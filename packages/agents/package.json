{
  "name": "@jstn-sdk/agents",
  "version": "0.1.0",
  "description": "Cross-agent environment compatibility SDK — detect, compile, validate",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/JustineDevs/agent-compat.git",
    "directory": "packages/agents"
  },
  "homepage": "https://github.com/JustineDevs/agent-compat#readme",
  "bugs": {
    "url": "https://github.com/JustineDevs/agent-compat/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.d.ts",
      "import": "./src/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --check src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test",
    "verify": "node --test test/conformance.test.js"
  },
  "engines": {
    "node": ">=18"
  }
}
